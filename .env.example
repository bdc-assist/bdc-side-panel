# bdc-side-panel settings. The LLM ones are bdc-assist's names: the same values work in both .env files.

# --- where the forms come from ---
DOC_MCP_URL=http://127.0.0.1:8001      # bdc-doc-mcp; its GET /chunks?doc_type=form serves bdc-llm's form blocks
FORMS_REFRESH_SECONDS=600              # how old the form list may get before it's fetched again

# --- the LLM (one structured-output call per panel turn) ---
COMPLETION_MODEL_PROVIDER=             # openai | azure | vllm | ollama; unset: guessed from COMPLETION_URL, else openai
COMPLETION_URL=                        # azure: the resource root; vllm/ollama: the server
COMPLETION_MODEL=gpt-4o-mini           # azure: the deployment name
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_API_VERSION=2024-10-21
COMPLETION_TEMPERATURE=0
COMPLETION_REASONING_EFFORT=           # unset for non-reasoning models; none|low|medium|high for reasoning ones

# --- serving ---
CORS_ORIGINS=*                         # browser origins allowed, comma-separated
MAX_RUNNING_CHATS=0                    # panel turns at once; 0 = no cap
MAX_WAITING_CHATS=0                    # more that may wait for a slot before a 503
LOG_LEVEL=WARNING
